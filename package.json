{
  "name": "oreno-platform-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:live": "cross-env E2E_LIVE=true playwright test",
    "api:generate": "openapi-typescript openapi/openapi.json -o lib/api/schema.d.ts",
    "api:check": "node scripts/check-openapi-types.mjs",
    "check": "npm run api:check && npm run typecheck && npm run lint && npm test && npm run build && npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "motion": "^13.4.4",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "cross-env": "^10.1.0",
    "eslint": "9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "eslint-config-next": "16.4.2",
    "openapi-typescript": "^7.13.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.2"
  },
  "overrides": {
    "source-map-js": "1.2.2"
  }
}
