# Browser-visible API and Socket.IO origins. Do not add a trailing slash.
NEXT_PUBLIC_ORENO_API_URL=http://localhost:4000
NEXT_PUBLIC_ORENO_SOCKET_URL=http://localhost:4000

# These names must match CSRF_COOKIE_NAME and CSRF_HEADER_NAME on the API.
NEXT_PUBLIC_ORENO_CSRF_COOKIE=oreno_csrf
NEXT_PUBLIC_ORENO_CSRF_HEADER=x-oreno-csrf

# Production deployments on sibling hosts should use a shared parent cookie
# domain on the API (for example SESSION_COOKIE_DOMAIN=.oreno.example).
# The browser sends credentials only to configured, exact CORS origins.

# Optional live browser-suite targets.
E2E_WEB_URL=http://localhost:3000
E2E_API_URL=http://localhost:4000
